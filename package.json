{
  "name": "mcp-swarmpit",
  "version": "0.2.0",
  "description": "MCP server for managing Swarmpit Docker Swarm instances",
  "type": "module",
  "bin": {
    "mcp-swarmpit": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "node --test dist/test/*.test.js",
    "pretest": "tsc",
    "prepare": "tsc"
  },
  "keywords": [
    "mcp",
    "swarmpit",
    "docker",
    "swarm",
    "claude"
